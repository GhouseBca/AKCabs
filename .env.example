# Convex
# Set automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Server-side URL (same value as NEXT_PUBLIC_CONVEX_URL when unset)
CONVEX_URL=

# First admin user (used by `npm run setup-admin`)
# Loaded into Convex automatically by `npx convex dev` from .env.local,
# or set explicitly with: npx convex env set ADMIN_EMAIL <email>
ADMIN_EMAIL=
ADMIN_PASSWORD=