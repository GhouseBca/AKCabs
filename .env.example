# Convex
# Set automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Server-side URL (same value as NEXT_PUBLIC_CONVEX_URL when unset)
CONVEX_URL=

# WorkOS AuthKit
# Find these on the WorkOS dashboard: https://dashboard.workos.com/get-started
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Must be at least 32 characters. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match the redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# First admin (used by `npm run setup-admin`)
# The email must match the WorkOS user's email. Set on the deployment with:
#   npx convex env set ADMIN_EMAIL <email>
ADMIN_EMAIL=
